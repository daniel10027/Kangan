# ---------------------------------------------------------------------------
# Kangan Finance — variables d'environnement
# Copier ce fichier en .env.local (apps/web) et .env (mobile / scripts)
# Ne jamais committer les vraies valeurs.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Mode de paiement ---------------------------------------------------------
# "simulator" = aucun argent réel déplacé, utilisé pour la démo/jury et le dev.
# "live" = appels réels vers Moov Money / agrégateur (nécessite les clés ci-dessous).
PAYMENT_MODE=simulator
NEXT_PUBLIC_PAYMENT_MODE=simulator

# --- Moov Money ---------------------------------------------------------------
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=
MOOV_MONEY_BASE_URL=https://api.moov-africa.ci

# --- Agrégateur (autres Mobile Money / cartes) --------------------------------
AGGREGATOR_PROVIDER=cinetpay
AGGREGATOR_API_KEY=
AGGREGATOR_API_SECRET=
AGGREGATOR_WEBHOOK_SECRET=

# --- Notifications --------------------------------------------------------------
EXPO_ACCESS_TOKEN=
SMS_PROVIDER_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=

# --- Observabilité --------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
VERCEL_ANALYTICS_ID=

# --- Divers -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Kangan Finance"
JWT_AUDIT_SALT=change-me-in-production
